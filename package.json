{
	"name": "itk-if2514504-database-management",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun --hot run src/app.ts",
		"migrate": "bun run src/database/migrate.ts",
		"format": "bun --bunx biome format --write",
		"check": "bun --bunx biome check",
      "docker": "systemctl start docker && systemctl stop postgresql && docker compose up -d"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@types/body-parser": "^1.19.6",
		"@types/bun": "latest",
		"@types/express": "^5.0.6"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"body-parser": "^2.3.0",
		"express": "^5.2.1",
		"jose": "^6.2.10",
		"zod": "^4.4.3"
	}
}
